# PostgreSQL
POSTGRES_DB=supportpilot
POSTGRES_USER=supportpilot
POSTGRES_PASSWORD=change_this_local_password
APP_DB_USER=supportpilot_app
APP_DB_PASSWORD=change_this_app_password
MIGRATION_DB_USER=supportpilot_migrator
MIGRATION_DB_PASSWORD=change_this_migration_password

# Replace with a securely generated secret outside local development.
JWT_SECRET=local-development-only-change-me

# Local ports
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_SUPPORTPILOT_APP_URL=https://your-public-https-tunnel.example

# Server-side AI provider used by the inbox and storefront widget.
# Use an OpenAI-compatible chat-completions endpoint; never expose this key in Next.js.
# AI provider credentials are loaded by the backend and worker from
# backend/.env. See backend/.env.example; do not put provider keys in frontend env.
# AI_PROVIDER_TIMEOUT_SECONDS=45
# AI_PROVIDER_MAX_ATTEMPTS=2

# Optional SMTP used by the backend to send shopper order verification codes.
# EMAIL_SMTP_HOST=smtp.example.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USERNAME=
# EMAIL_SMTP_PASSWORD=
# EMAIL_FROM_ADDRESS=support@example.com
# EMAIL_USE_SSL=false

# Keeps container names stable in this workspace folder
COMPOSE_PROJECT_NAME=supportpilot-ai
