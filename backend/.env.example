APP_NAME=SupportPilot AI
APP_ENV=development
DEBUG=true

API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://supportpilot_app:change_this_app_password@postgres:5432/supportpilot

REDIS_URL=redis://redis:6379/0

# Replace with a securely generated secret outside local development.
JWT_SECRET=local-development-only-change-me
# Access JWT lifetime (minutes). Refresh tokens last longer; keep Next proxy cookie in sync via AUTH_REFRESH_COOKIE_MAX_AGE_SECONDS if you override refresh days.
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=30

CORS_ORIGINS=["http://localhost:3000"]

LOG_LEVEL=INFO
WORKER_CONCURRENCY=4
WORKER_JOB_TIMEOUT_SECONDS=110

# Optional OpenAI-compatible model gateway. Keep credentials server-side.
# The playground and draft actions remain unavailable until base URL and model are configured.
# Loaded by both the API and background worker in Docker Compose.
# AI_PROVIDER_BASE_URL=https://api.openai.com/v1
# AI_PROVIDER_API_KEY=your-server-side-provider-key
# AI_MODEL=gpt-4o-mini
AI_PROVIDER_TIMEOUT_SECONDS=45
AI_PROVIDER_MAX_ATTEMPTS=2
# Optional per-million-token price inputs for AI analytics. Leave unset to hide estimated cost.
# AI_INPUT_COST_PER_MILLION=0.15
# AI_OUTPUT_COST_PER_MILLION=0.60

# Shopify integration. Create an app in Shopify Dev Dashboard and configure
# this exact callback URI in the app's allowed redirect URLs. Keep these values
# server-side and generate SHOPIFY_ENCRYPTION_KEY with Fernet.generate_key().
# The app requests read_orders, read_customers, and read_products. Stores must
# grant read_products to sync/browse the product catalog. Customer fields can
# still require separate Shopify protected-customer-data approval.
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=
# Optional local development shortcut for one preinstalled store. Requires the
# Shopify app and store to belong to the same Shopify organization; never use this
# fixed-store mode in production. Tokens are still encrypted at rest.
# SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# Configure an HTTPS tunnel URL for local Shopify OAuth; Shopify validates the exact URI.
# SHOPIFY_REDIRECT_URI=https://your-https-tunnel.example/api/integrations/shopify/callback
# SHOPIFY_ENCRYPTION_KEY=
SHOPIFY_API_VERSION=2026-10

# Required SMTP used by workspace login/registration/password-recovery OTP and
# Shopify order verification. Workspace authentication fails closed without it.
# EMAIL_SMTP_HOST=smtp.example.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USERNAME=
# EMAIL_SMTP_PASSWORD=
# EMAIL_FROM_ADDRESS=support@example.com
# EMAIL_USE_SSL=false
